# ---- 数据库(必填)----
# 生产:去 turso.tech 建一个 database,把 URL 和 token 填这里
# 本地开发:也可以留空,会 fallback 到 file:./data/meemate.db 的嵌入模式(免鉴权)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# ---- LLM(可选)----
# 不配也能跑,此时用内置剧本;配了聊天会更像真的
DEEPSEEK_API_KEY=
# 可选:换成其他 OpenAI 兼容端点
# LLM_BASE_URL=https://api.deepseek.com/chat/completions
# LLM_MODEL=deepseek-chat
